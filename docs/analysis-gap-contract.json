{
  "schema_version": 1,
  "_comment": "ANALYSE v2 gap taxonomy and work-queue rules. Playbook: .cursor/pipelines/analysis.md. Template: epics/templates/analysis-ref.json schema v2.",
  "gap_kinds": [
    "obligation_uncovered",
    "snippet_missing",
    "nested_req_unresolved",
    "deferred_check",
    "deferral_coverage_drift",
    "ungrounded_check",
    "grounding_weak",
    "tooling_blocked",
    "env_blocked",
    "anti_pattern",
    "human_ba",
    "scenario_row_uncovered",
    "platform_invariant_annex_only",
    "console_probe_failed",
    "draft_truth_loop_exhausted"
  ],
  "confidence_levels": ["high", "medium", "low"],
  "emit_forbidden_confidence": ["low"],
  "recommended_actions": [
    "rerun_coverage",
    "rerun_epic_prep",
    "confluence_resolve",
    "human_ba",
    "ignore_for_discover",
    "ignore_for_prep",
    "human_operator"
  ],
  "gap_status": ["open", "resolved", "confirmed_gap"],
  "resolution_types": [
    "confluence_snippet",
    "coverage_updated",
    "false_positive"
  ],
  "max_open_gaps_emit": 15,
  "max_resolve_attempts_per_run": 8,
  "work_queue_sources": [
    {
      "id": "deferred_check",
      "scan": "coverage.checks[] where calculation_contract is deferred_ambiguous or ambiguity is set"
    },
    {
      "id": "ungrounded_check",
      "scan": "coverage.grounding_audit.ungrounded_check_ids"
    },
    {
      "id": "nested_req_unresolved",
      "scan": "coverage.nested_requirement_refs[] where page_id or short_url is null"
    },
    {
      "id": "obligation_uncovered",
      "scan": "ref.obligations_proposed primary_candidate not covered in obligations_coverage; skip when coverage.schema_version >= 2 and obligations_coverage row-complete"
    },
    {
      "id": "snippet_missing",
      "scan": "ref.requirements[] where snippet_status is missing or failed"
    },
    {
      "id": "anti_pattern",
      "scan": "coverage.anti_pattern_findings[]"
    },
    {
      "id": "deferral_obligation_keyed",
      "scan": "ref deferral obligations cross obligations_coverage.deferred_in_check and checks with obligation_ids"
    }
  ],
  "exploration_suppression_kinds": [
    "deferred_check",
    "human_ba"
  ],
  "recommended_action_by_kind": {
    "obligation_uncovered": "rerun_coverage",
    "snippet_missing": "rerun_epic_prep",
    "nested_req_unresolved": "confluence_resolve",
    "deferred_check": "ignore_for_discover",
    "deferral_coverage_drift": "rerun_coverage",
    "ungrounded_check": "rerun_coverage",
    "grounding_weak": "rerun_coverage",
    "tooling_blocked": "human_ba",
    "env_blocked": "human_ba",
    "anti_pattern": "rerun_coverage",
    "human_ba": "human_ba",
    "scenario_row_uncovered": "rerun_coverage",
    "platform_invariant_annex_only": "rerun_coverage",
    "console_probe_failed": "human_operator",
    "draft_truth_loop_exhausted": "human_operator"
  },
  "_operator_notes": "Principal deferrals (Round 2): use deferred_check with pointers.obligation_id required; exploration_suppressed reason deferral_obligation_keyed for keyed ! checks. See docs/analysis-principal-contract.json."
}
