{
  "schema_version": 1,
  "_comment": "Spec-cell patterns → mandated checklist variations. EPIC-PREP applies after parameter_inventory[]; COVERAGE keeps 1:1 obligation→check. Not epic-specific — match structure of Confluence parameter cells.",
  "variation_kinds": ["positive", "negative", "boundary", "absence", "structural"],
  "collapse_rules": {
    "identical_spec_text": "Parameters whose normalized spec_text matches the same catalogue rule may emit one obligation listing all parameter names in assertion_fragment (e.g. Fees and Commission unsigned).",
    "header_format_with_components": "When header_format matches, do not also mandate separate structural checks for each token already listed in the template unless the cell adds sign/color/precision rules."
  },
  "rules": [
    {
      "id": "signed_colored",
      "match_any": [
        "signed",
        "colored",
        "green for positive",
        "red for negative",
        "green positive",
        "red negative"
      ],
      "require_all_groups": [["signed"], ["colored", "green", "red"]],
      "mandates": [
        {
          "kind": "negative",
          "assertion_hint": "negative value shows minus sign and red"
        },
        {
          "kind": "positive",
          "assertion_hint": "positive value shows green (and plus or unsigned per cell)"
        }
      ],
      "collapse": false,
      "needs_setup": true
    },
    {
      "id": "unsigned",
      "match_any": ["not signed", "unsigned", "no sign"],
      "mandates": [
        {
          "kind": "negative",
          "assertion_hint": "source-negative quantity/value displays without a minus sign"
        }
      ],
      "collapse": true,
      "needs_setup": true
    },
    {
      "id": "presence_conditional",
      "match_any": [
        "displayed only if not empty",
        "only if not empty",
        "if available",
        "when available",
        "when symbol is available"
      ],
      "mandates": [
        {
          "kind": "positive",
          "assertion_hint": "value present → field shown"
        },
        {
          "kind": "absence",
          "assertion_hint": "value empty/unavailable → field hidden"
        }
      ],
      "collapse": false,
      "needs_setup": true
    },
    {
      "id": "precision_native",
      "match_any": [
        "native with",
        "digits precision",
        "2 digits",
        "2dp",
        "two decimal"
      ],
      "mandates": [
        {
          "kind": "boundary",
          "assertion_hint": "value at rounding boundary uses stated precision"
        },
        {
          "kind": "positive",
          "assertion_hint": "shorter fractional part still renders in native format"
        }
      ],
      "collapse": true,
      "needs_setup": false
    },
    {
      "id": "enum_values",
      "match_any": ["buy or sell", "buy/sell", "green for buy", "red for sell"],
      "mandates": [
        {
          "kind": "positive",
          "assertion_hint": "Buy label with green"
        },
        {
          "kind": "positive",
          "assertion_hint": "Sell label with red",
          "parameter_suffix": "sell"
        }
      ],
      "collapse": false,
      "needs_setup": true
    },
    {
      "id": "currency_symbol",
      "match_any": [
        "account currency symbol",
        "currency symbol",
        "with account currency"
      ],
      "mandates": [
        {
          "kind": "positive",
          "assertion_hint": "value shows account currency symbol"
        }
      ],
      "collapse": true,
      "needs_setup": false
    },
    {
      "id": "aggregate_value",
      "match_any": ["average fill", "avg fill", "total cost", "total cash"],
      "mandates": [
        {
          "kind": "positive",
          "assertion_hint": "multi-fill or aggregate input shows averaged/totalled value not last tick alone"
        }
      ],
      "collapse": false,
      "needs_setup": true
    },
    {
      "id": "navigation_conditional",
      "match_any": [
        "redirect",
        "instrument page",
        "tradable instrument"
      ],
      "mandates": [
        {
          "kind": "positive",
          "assertion_hint": "tradable instrument → header navigates to Instrument page"
        },
        {
          "kind": "absence",
          "assertion_hint": "non-tradable → no Instrument navigation"
        }
      ],
      "collapse": false,
      "needs_setup": true
    },
    {
      "id": "default_state",
      "match_any": [
        "collapsed by default",
        "default collapsed",
        "expanded by default"
      ],
      "mandates": [
        {
          "kind": "positive",
          "assertion_hint": "default collapsed/expanded state as specified"
        },
        {
          "kind": "positive",
          "assertion_hint": "control toggles to the opposite state",
          "parameter_suffix": "toggle"
        }
      ],
      "collapse": false,
      "needs_setup": false
    },
    {
      "id": "header_format",
      "match_any": [
        "<side>",
        "side><quantity>",
        "@<fill",
        "header format",
        "non-options format"
      ],
      "mandates": [
        {
          "kind": "structural",
          "assertion_hint": "header follows documented token order for non-options"
        }
      ],
      "collapse": true,
      "needs_setup": false
    }
  ],
  "fallback": {
    "id": "plain_presence",
    "when": "inventory row matches no rule",
    "mandates": [
      {
        "kind": "positive",
        "assertion_hint": "field is present and matches stated formatting"
      }
    ],
    "record_unmatched": true
  }
}
