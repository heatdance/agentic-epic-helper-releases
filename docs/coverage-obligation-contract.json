{
  "schema_version": 2,
  "_comment": "COVERAGE obligation closure vs epic-ref obligations_proposed[]. Playbook: .cursor/pipelines/coverage.md. Kinds: docs/epic-obligation-kinds.json. D18: variation catalogue, oracle detail lines, Not attempted, neutral Data setup.",
  "row_complete_rule": "Every obligations_proposed[] row with disposition primary_candidate must appear in obligations_coverage with status covered or excluded_with_reason (with obligation_id on exclusion).",
  "obligations_coverage_status": [
    "covered",
    "deferred_in_check",
    "excluded_with_reason"
  ],
  "forbidden_scenario_patterns": [
    {
      "id": "blanket_multi_group_silent",
      "regex": "epic silent on multi-account|multi-group quote permutations",
      "message": "Use dedicated invariant check or keyed deferral tied to obligation_id; do not blanket-defer group/invariant work under Dimensions."
    },
    {
      "id": "bare_tbd_executable",
      "regex": "^\\s*-\\s*!\\s+reason:.*silent on",
      "when": "ref_has_primary_candidate_invariant",
      "message": "When ref proposes invariant obligations, emit executable primary check under ## Invariants under configuration change."
    }
  ],
  "section_requirements": {
    "invariants_section_heading": "## Invariants under configuration change",
    "rounding_section_heading": "## Rounding and display policy",
    "environment_setup_section_heading": "## Data setup",
    "require_invariants_section_when": "ref.obligations_proposed has any kind invariant with disposition primary_candidate",
    "require_rounding_section_when": "ref.obligations_proposed has any kind rounding with disposition primary_candidate",
    "require_environment_setup_section_when": "ref.verification_topology.principal_coverage_threads has coverage_thread environment_setup OR ref.obligations_proposed has kind environment_setup with disposition primary_candidate",
    "not_attempted_section_heading": "## Not attempted"
  },
  "deferral_obligations_coverage_status": "deferred_in_check",
  "dimensions_phase_rules": {
    "allow_dimension_line_only_when": [
      "jira_epic_text_mentions_dimension",
      "matching_obligation_id_in_ref",
      "snippet_text_mentions_dimension",
      "variation_catalogue_rule"
    ],
    "forbid_generic_deferral_when": "ref contains primary_candidate invariant with config_vs_position position_state or account_group_assignment"
  },
  "anti_pattern_ids": [
    "dimension_deferral_without_obligation_review",
    "obligation_without_check_or_exclusion",
    "invariant_obligation_in_dimensions_only",
    "deferral_without_obligation_id",
    "setup_thread_missing_checks",
    "focus_drift_from_ref_proposed",
    "tag_level_stub_check",
    "single_stub_subsection",
    "redundant_context_prefix",
    "collapsed_intro_violation",
    "obligation_without_atomic_check",
    "machine_deferral_reason",
    "availability_misplaced",
    "invariants_section_without_config_vs_position",
    "observable_yield_shortfall",
    "rounding_section_on_shell_first",
    "variation_shortfall",
    "missing_variation_oracle_detail",
    "parity_on_availability"
  ],
  "tag_level_stub_patterns": [
    "card is available",
    "is present and visible",
    "must expose .+ per linked",
    "details card is available",
    "trade card is available",
    "transaction card is available",
    "transaction details card is available",
    "trade details card is available"
  ],
  "forbidden_deferral_reason_enums": [
    "mcp_export_failed",
    "no_cookie",
    "yogi_extract_empty",
    "page_id_unresolved",
    "macro_shape_unsupported",
    "other"
  ],
  "deferral_reason_rules": {
    "forbid_bare_snippet_failure_enums": true,
    "require_human_sentence": true,
    "min_reason_chars": 24,
    "prefer_requirement_key_in_reason": true,
    "_note": "Paste '! reason:' must name what is unavailable and which key; never dump snippet_failure_reason enums alone."
  },
  "availability_placement": {
    "widget_ui_without_config_vs_position": "prerequisites",
    "prerequisites_section_heading": "## Prerequisites",
    "does_not_count_toward_observable_yield": true,
    "exempt_only_when_check_obligation_config_vs_position": true,
    "_note": "Card/trade availability is a setup gate for widget_ui, not a field-level check under surface subsections."
  },
  "invariants_section_rules": {
    "heading": "## Invariants under configuration change",
    "allow_only_when_ref_has_config_vs_position": true
  },
  "atomic_check_rules": {
    "one_primary_obligation_per_check": true,
    "scenario_line_from_assertion_fragment": true,
    "subsection_from_emit_subsection": true,
    "forbid_primary_focus_in_paste": true,
    "prerequisites_section_heading": "## Prerequisites",
    "stub_check_always_errors_on_primary": true,
    "single_stub_subsection_errors": true,
    "redundant_context_token_match": true,
    "observable_yield_min_primary_checks": true,
    "variation_oracle_detail_required": true,
    "variation_oracle_from_spec_text": true,
    "variation_oracle_detail_distinct": true,
    "forbid_empty_markdown_sections": true,
    "not_attempted_section_when_unmatched_or_out_of_scope": true
  },
  "excluded_checks_item_fields": [
    "check_id",
    "reason",
    "obligation_id",
    "evidence"
  ],
  "reinforce_allowed_inputs": {
    "_comment": "COVERAGE-REINFORCE: only — production COVERAGE still forbids -discover.json",
    "playbook": ".cursor/pipelines/coverage-reinforce.md",
    "discover_jq_paths": [
      "verification_affordances",
      "verification_affordances[].oracle_binding",
      "verification_affordances[].topology_surface_id",
      "obligation_ledger",
      "fixture_needs",
      "fixture_needs[].linked_obligation_ids",
      "fixture_needs[].derivation",
      "sources.principal_loaded",
      "principal_provenance",
      "environment.client_shell_impact",
      "sources.topology_loaded",
      "discovery_status"
    ],
    "helper_files": [
      "epics/<KEY>/helper/affordances-slice.json",
      "epics/<KEY>/helper/operator-feedback.md"
    ],
    "merge_base": "epics/<KEY>/dependencies/<KEY>-coverage.json",
    "emit_fields": [
      "coverage_pass",
      "reinforced_at",
      "sources.reinforce_inputs",
      "sources.reinforce_topology_loaded",
      "sources.reinforce_principal_loaded"
    ],
    "topology_contract": "docs/coverage-reinforce-topology-contract.json",
    "principal_contract": "docs/coverage-reinforce-principal-contract.json"
  },
  "variation_rules": {
    "catalogue": "docs/variation-catalogue.json",
    "oracle_detail_min": 1,
    "needs_setup_field": "needs_setup"
  }
}
