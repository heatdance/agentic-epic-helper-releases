{
  "schema_version": 1,
  "_comment": "ANALYSE topology consumption from EPIC-PREP ref + COVERAGE delivery/oracle bindings. Playbook: .cursor/pipelines/analysis.md phases 1, 2-3, 5, 10. Verifier: automation/tools/analysis_verify.py --strict-topology. Upstream: docs/epic-prep-topology-contract.json, docs/coverage-topology-contract.json.",
  "gap_kinds_extension": [
    "delivery_known_fail",
    "delivery_excluded",
    "surface_oracle_unresolved",
    "delivery_coverage_drift"
  ],
  "recommended_action_by_kind": {
    "delivery_known_fail": "human_ba",
    "delivery_excluded": "ignore_for_discover",
    "surface_oracle_unresolved": "human_ba",
    "delivery_coverage_drift": "rerun_coverage"
  },
  "delivery_status_map": {
    "known_fail": "failed",
    "excluded": "excluded"
  },
  "work_queue_sources": [
    {
      "id": "delivery_known_fail",
      "scan": "ref.verification_topology.delivery_notes[] where status=known_fail"
    },
    {
      "id": "delivery_excluded",
      "scan": "ref.verification_topology.delivery_notes[] where status=excluded"
    },
    {
      "id": "delivery_coverage_drift",
      "scan": "ref delivery_note present but no coverage check with matching delivery_status"
    },
    {
      "id": "surface_oracle_unresolved",
      "scan": "ref.verification_topology.pricing_oracle_rules[] where oracle_rule=unresolved"
    }
  ],
  "exploration_suppression": {
    "coverage_delivery_status": {
      "failed": {
        "reason": "delivery_known_fail",
        "blocks_fixture_probe": true,
        "until_action": "human_ba"
      },
      "excluded": {
        "reason": "delivery_excluded",
        "blocks_fixture_probe": true,
        "until_action": "human_ba"
      }
    }
  },
  "gap_emit_rules": {
    "delivery_known_fail": {
      "confidence": "high",
      "status_when_coverage_honest": "confirmed_gap",
      "status_when_drift": "open",
      "pointers": ["delivery_note_id", "check_id"]
    },
    "delivery_excluded": {
      "confidence": "high",
      "status_when_coverage_honest": "confirmed_gap",
      "status_when_drift": "open",
      "pointers": ["delivery_note_id", "check_id"]
    },
    "surface_oracle_unresolved": {
      "confidence": "high",
      "status": "open",
      "pointers": ["oracle_rule_id", "requirement_key"]
    },
    "delivery_coverage_drift": {
      "confidence": "high",
      "status": "open",
      "pointers": ["delivery_note_id"]
    }
  },
  "forbidden_gaps": [
    "shell_layout_missing",
    "emit_layout_mismatch"
  ],
  "strict_topology_verifier": {
    "requires_ref": true,
    "requires_coverage": true,
    "checks": [
      "each ref delivery_notes known_fail has delivery_known_fail gap with delivery_note_id",
      "each ref delivery_notes excluded has delivery_excluded gap with delivery_note_id",
      "each ref pricing_oracle_rules oracle_rule=unresolved has surface_oracle_unresolved gap",
      "each coverage check delivery_status failed|excluded has exploration_suppressed row"
    ]
  }
}
