{
  "schema_version": 1,
  "_comment": "TEST-PREP topology consumption from PRECON, COVERAGE/Reinforce, EPIC-PREP ref. Playbook: .cursor/pipelines/test-prep.md. Verifier: automation/tools/test_prep_verify.py --strict-topology. Upstream: docs/precon-topology-contract.json, docs/coverage-topology-contract.json, docs/test-prep-tbd-contract.json.",
  "inputs": {
    "precon_slices": [
      "command_patterns",
      "test_skeleton[].case_outline[].pattern_ref",
      "excluded_checks_with_reason",
      "sources.topology_loaded",
      "session_placeholders",
      "sources.principal_loaded",
      "precon_clusters[].id"
    ],
    "coverage_slices": [
      "emit_layout",
      "archetype",
      "checks[].oracle_rule_id",
      "checks[].topology_surface_id",
      "checks[].delivery_status",
      "platform_reuse_annex"
    ],
    "ref_slices": [
      "verification_topology.pricing_oracle_rules",
      "verification_topology.platform_reuse_candidates",
      "verification_topology.jira_scenario_surfaces"
    ]
  },
  "pattern_ref_expansion": {
    "inherits_oracle_map": "docs/precon-topology-contract.json oracle_rule_to_pattern_ref",
    "single_pair_per_case_outline_row": {
      "pattern_ref_keys": [
        "ladder_step",
        "watchlist_tier_by_qty",
        "position_first_tier_quote",
        "console_show_prices_first_tier",
        "midpoint_invariant_observe",
        "mark_from_midpoint_observe",
        "console_config_show"
      ],
      "rule": "One numbered Action and one Result per case_outline row; command_patterns lines are sub-bullets inside that Action."
    }
  },
  "reuse_annex": {
    "source_priority": ["coverage.platform_reuse_annex", "ref.verification_topology.platform_reuse_candidates"],
    "emit_field": "platform_reuse_annex",
    "emit_to_markdown": false,
    "forbidden": "CRTQA keys in durable JSON; platform reuse heading in -tests.md body",
    "binding": "suggestion_only on ref candidates"
  },
  "skip_bundle_checks": {
    "sources": [
      "precon.excluded_checks_with_reason",
      "coverage.checks delivery_status failed or excluded",
      "coverage.checks verification_role out_of_epic deferral_only",
      "precon excluded_checks_with_reason reason deferral_obligation_keyed",
      "tests.excluded_checks_with_reason"
    ],
    "emit": "reverse_validation.coverage_gaps[] mirroring excluded_checks_with_reason",
    "forbidden": "delivery-blocked primary in test_bundles covers_check_ids"
  },
  "shell_first_batches": {
    "phase_8a_three_quarter_group_by": "topology_surface_id matching ref jira_scenario_surfaces[].id",
    "validation_log_step": "phase8a_skipped_delivery_blocked"
  },
  "strict_topology_verifier": {
    "requires_precon": true,
    "requires_ref": true,
    "modes": ["draft", "merge", "tests"],
    "checks": [
      "pattern_ref rows: action sub-bullets reference precon command_patterns key",
      "delivery excluded primary: coverage_gaps + not in covers_check_ids",
      "platform_reuse_annex: no CRTQA keys; present when ref has platform_reuse_candidates and topology loaded",
      "legacy tests without topology_loaded: strict oracle/reuse rules no-op"
    ],
    "validation_log_steps": ["phase1-topology", "phase8b_topology", "phase8a_skipped_delivery_blocked"]
  },
  "principal_contract": "docs/test-prep-principal-contract.json",
  "validation_log_steps_principal": [
    "phase1-principal",
    "phase8a_persona_split",
    "phase8b_principal_paste"
  ],
  "downstream_handoff": {
    "close": "implemented — cross-artifact oracle/session lint; see docs/close-topology-contract.json and .cursor/pipelines/close.md Phase E½ (8/8 complete)"
  }
}
