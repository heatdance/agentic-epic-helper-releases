{
  "schema_version": 1,
  "_comment": "Verification topology emitted by EPIC-PREP on -ref.json (schema v4 additive). Playbook: .cursor/pipelines/epic-prep.md steps 2c, 3f, 3g, 3h. Verifier: automation/tools/epic_prep_verify.py --strict-topology.",
  "ref_fields": {
    "epic_archetype": {
      "type": "object",
      "required_when_strict": true,
      "properties": {
        "value": {
          "enum": ["widget_ui", "metrics_calculation", "mixed"]
        },
        "source": {
          "enum": [
            "jira_summary",
            "jira_description",
            "jira_scenarios",
            "obligation_kinds",
            "user_trigger_focus",
            "inferred_from_jira"
          ]
        },
        "evidence": "Short citation; verbatim Jira in evidence only"
      }
    },
    "verification_topology": {
      "type": "object",
      "required_when_strict": true,
      "properties": {
        "jira_scenario_surfaces": "array of jira_scenario_surface_item",
        "shell_roles": "object shell_roles_shape",
        "pricing_oracle_rules": "array of pricing_oracle_rule_item",
        "delivery_notes": "array of delivery_note_item",
        "platform_reuse_candidates": "array of platform_reuse_candidate_item",
        "scenario_capability_rows": "array of scenario_capability_row_item — see docs/epic-prep-scenario-contract.json"
      }
    }
  },
  "scenario_capability_row_item": {
    "id": "scr-001",
    "jira_surface_id": "optional jss-###",
    "platform_reuse_id": "optional prc-###",
    "source_quote": "string",
    "surface": "stable surface id",
    "capability_kind": "jira_scenario | platform_invariant | cross_surface | setup",
    "promotion": "primary_candidate | platform_invariant | deferral_candidate",
    "linked_requirement_keys": ["CRT-1714"],
    "obligation_ids": ["obl-003"]
  },
  "jira_scenario_surface_item": {
    "id": "jss-001",
    "surface": "Stable id e.g. dxtrade5_watchlist",
    "shell": "console | dxtrade5 | adaptive | webbroker_dealer | webbroker_client",
    "widget": "Watchlist | Positions | Derivatives | User Management | Client Area | Instrument page | ...",
    "metric": "bid_ask | mark | backup_price | config | null",
    "source_quote": "Verbatim excerpt from Jira scenario block",
    "obligation_ids": ["obl-001"]
  },
  "shell_roles_shape": {
    "console": { "status": "in_scope | not_applicable", "evidence": "string" },
    "dxtrade5": { "status": "in_scope | not_applicable", "evidence": "string" },
    "adaptive": { "status": "in_scope | not_applicable", "evidence": "string" },
    "webbroker_dealer": { "status": "in_scope | not_applicable", "evidence": "string" },
    "webbroker_client": { "status": "in_scope | not_applicable", "evidence": "string" }
  },
  "pricing_oracle_rule_item": {
    "id": "por-001",
    "surface": "Stable surface id matching jira_scenario_surfaces.surface or console_*",
    "metric": "bid_ask | mark | midpoint | backup_price | close_price",
    "volume_control": "order_default_qty | order_qty | position_qty | first_tier | not_applicable",
    "oracle_rule": "See oracle_rule_enum",
    "requirement_keys": ["CRT-1714"],
    "evidence_anchor": "snippet excerpt or jira field",
    "obligation_ids": ["obl-003"],
    "disposition": "primary_candidate | deferral_candidate when oracle_rule is unresolved"
  },
  "oracle_rule_enum": [
    "first_tier_quote",
    "text_configuration_closest_gte_qty",
    "midpoint_invariant",
    "mark_from_midpoint",
    "console_show_prices_first_tier",
    "console_agent_event_quote",
    "console_agent_event_text_configuration",
    "backup_midpoint_at_eod",
    "unresolved"
  ],
  "oracle_rule_when": {
    "first_tier_quote": "Positions/Derivatives/Order book widgets consume Quote stream first tier only",
    "text_configuration_closest_gte_qty": "Watchlist/OE Bid-Ask from TextConfiguration tier closest >= quantity",
    "midpoint_invariant": "Midpoint same across account groups or volume tiers for FX_SPOT",
    "mark_from_midpoint": "Mark price equals midpoint for FX_SPOT",
    "console_show_prices_first_tier": "show prices bid/ask from first TextConfiguration tier",
    "console_agent_event_quote": "quoting agent_event_from Quote event",
    "console_agent_event_text_configuration": "quoting agent_event_from TextConfiguration full book",
    "backup_midpoint_at_eod": "EOD/backup saves midpoint as closePrice",
    "unresolved": "Snippet silent on surface-specific rule; feeds ANALYSE gap"
  },
  "delivery_note_item": {
    "id": "dn-001",
    "target": "Surface/widget/check intent e.g. dxtrade5_derivatives_widget",
    "status": "known_fail | excluded | waived | pending_verification",
    "source": "jira_comment | jira_description | operator_focus | post_implementation",
    "evidence": "Verbatim Jira or operator citation; never inferred from absence",
    "linked_obligation_ids": ["obl-002"],
    "linked_surface_ids": ["jss-004"]
  },
  "principal_coverage_thread_item": {
    "thread_id": "pct-001",
    "title": "Data setup — account groups and quote publication",
    "coverage_thread": "environment_setup | functional_config | mapping_routing | surface_quotes | invariants | backup_eod | dimensions | deferral_only",
    "obligation_ids": ["obl-001"],
    "required_when": "widget_ui_setup_thread | widget_ui_invariants_thread | widget_ui_backup_thread | null"
  },
  "platform_reuse_candidate_item": {
    "id": "prc-001",
    "topic": "EOD backup | mark price column | daily_data_recorder | ...",
    "suggested_crtqa_pattern": "Human-readable pattern e.g. CRTQA-2792 family for EOD backup",
    "confidence": "high | medium | low",
    "evidence": "Keyword or requirement key trigger",
    "binding": "suggestion_only"
  },
  "optional_by_archetype": {
    "metrics_calculation": {
      "jira_scenario_surfaces": "May be [] when Jira has no widget scenario block",
      "pricing_oracle_rules": "May be [] when no quote/tier/mark keywords in Jira/snippets",
      "delivery_notes": "May be []",
      "platform_reuse_candidates": "May be []"
    },
    "widget_ui": {
      "jira_scenario_surfaces": "Required non-empty when Jira Scenarios block present (--strict-topology)",
      "pricing_oracle_rules": "Required non-empty when quote/tier keywords present",
      "delivery_notes": "Optional",
      "platform_reuse_candidates": "Optional"
    },
    "mixed": {
      "jira_scenario_surfaces": "Required non-empty when Jira Scenarios block present",
      "pricing_oracle_rules": "Required when quote/tier and UI surfaces both present",
      "delivery_notes": "Optional",
      "platform_reuse_candidates": "Optional"
    }
  },
  "handoff_table": [
    {
      "field": "epic_archetype.value",
      "consumer_pipeline": "COVERAGE",
      "consumer_phase": "3",
      "use": "Copy to coverage.archetype; skip re-inference when present"
    },
    {
      "field": "verification_topology.jira_scenario_surfaces",
      "consumer_pipeline": "COVERAGE",
      "consumer_phase": "4",
      "use": "Seed coverage_matrix.surfaces and runner-view emit"
    },
    {
      "field": "verification_topology.shell_roles",
      "consumer_pipeline": "COVERAGE",
      "consumer_phase": "4",
      "use": "Dealer vs client WebBroker checks"
    },
    {
      "field": "verification_topology.pricing_oracle_rules",
      "consumer_pipeline": "TEST-DISCOVER",
      "consumer_phase": "E",
      "use": "verification_affordances oracle_binding"
    },
    {
      "field": "verification_topology.delivery_notes",
      "consumer_pipeline": "ANALYSE",
      "consumer_phase": "gaps",
      "use": "delivery_known_fail gap kind"
    },
    {
      "field": "pricing_oracle_rules.oracle_rule=unresolved",
      "consumer_pipeline": "ANALYSE",
      "consumer_phase": "gaps",
      "use": "surface_oracle_unresolved gap kind"
    },
    {
      "field": "verification_topology.platform_reuse_candidates",
      "consumer_pipeline": "TEST-PREP",
      "consumer_phase": "8b",
      "use": "suggested_crtqa_links annex only; not structural input"
    },
    {
      "field": "verification_topology.shell_roles",
      "consumer_pipeline": "TEST-PRECON",
      "consumer_phase": "2b",
      "use": "session_placeholders and dealer/client clusters"
    },
    {
      "field": "verification_topology.pricing_oracle_rules",
      "consumer_pipeline": "CLOSE",
      "consumer_phase": "L3",
      "use": "Oracle consistency lint vs tests"
    },
    {
      "field": "obligations_proposed[].downstream_hints",
      "consumer_pipeline": "COVERAGE",
      "consumer_phase": "3",
      "use": "Per-obligation coverage thread and provisioning flags"
    },
    {
      "field": "verification_topology.principal_coverage_threads",
      "consumer_pipeline": "COVERAGE",
      "consumer_phase": "3",
      "use": "Ordered checklist spine intent"
    },
    {
      "field": "verification_focus_proposed",
      "consumer_pipeline": "COVERAGE",
      "consumer_phase": "1",
      "use": "Primary focus seed — copy without paraphrase"
    }
  ],
  "platform_reuse_keyword_triggers": [
    "EOD",
    "backup price",
    "daily_data_recorder",
    "Summary.closePrice",
    "mark price column",
    "Mark Price"
  ],
  "appendix_examples": {
    "CRT-639": {
      "epic_archetype": "metrics_calculation",
      "jira_scenario_surfaces": [],
      "pricing_oracle_rules": []
    },
    "CRT-594": {
      "epic_archetype": "widget_ui",
      "scenario_surface_count_min": 5,
      "pricing_oracle_rules_sample": [
        {
          "surface": "dxtrade5_watchlist",
          "oracle_rule": "text_configuration_closest_gte_qty"
        },
        {
          "surface": "dxtrade5_positions",
          "oracle_rule": "first_tier_quote"
        },
        {
          "surface": "dxtrade5_derivatives",
          "oracle_rule": "first_tier_quote"
        }
      ]
    }
  }
}
