{
  "schema_version": 3,
  "program_id": "draft_truth_v3",
  "program_complete": true,
  "description": "Draft+truth v3: machine loop + human coverage review + scenario_groups at freeze + DISCOVER linker + TEST-PREP scenario_intent (no PRECON, no generation UI exploration).",
  "changelog_v3": [
    "TEST-PRECON removed from production chain",
    "scenario_groups[] on coverage at freeze",
    "TEST-PREP default profile scenario_intent",
    "No live UI/console exploration during TEST-PREP generation"
  ],
  "changelog_v2": [
    "TEST-DISCOVER is linker-only; full Phase 0 + Step E removed",
    "discover_creds helper gate removed",
    "PRECON/PREP decoupled from discover probes"
  ],
  "recommended_chain": [
    "prepare",
    "epic_prep",
    "coverage",
    "ground",
    "analyse",
    "coverage_review",
    "discover",
    "test_prep",
    "close"
  ],
  "deprecated_stages": ["precon", "coverage_reinforce"],
  "draft_truth_loop": {
    "max_rounds": 2,
    "stages": ["coverage", "ground", "analyse"],
    "on_rerun_coverage": "COVERAGE: <KEY> fix_breadth=yes",
    "on_human_gate": "coverage_review after loop exhaust or draft_truth_recommendation human_coverage_review; operator may edit scenario_groups[]"
  },
  "human_gates": [
    {
      "id": "coverage_review",
      "after_stages": ["analyse"],
      "action": "Operator merges coverage toward gold minimum; edits scenario_groups[]; sets coverage_frozen_at on resume"
    }
  ],
  "legacy_optional": ["coverage_reinforce", "test_precon"],
  "forbidden_generation_inputs": [
    "CRTQA Jira issues as structural inputs",
    ".cursor/calibrate/<KEY>-gold/ during generation pipelines",
    "-tests.json as COVERAGE/EPIC-PREP input",
    "-precon.json as TEST-PREP structural input in v3 chain"
  ],
  "calibrate": {
    "in_pipeline_chain": false,
    "command": "/epic-calibrate",
    "use": "Optional post-CLOSE compare prod vs operator gold; not a blocking gate"
  },
  "per_stage_contracts": {
    "epic_prep": {
      "contract": "docs/epic-prep-scenario-contract.json",
      "playbook": ".cursor/pipelines/epic-prep.md",
      "verifier": "python automation/tools/epic_prep_verify.py --mode scenario --ref epics/<KEY>/dependencies/<KEY>-ref.json",
      "emit_dod": [
        "verification_topology.scenario_capability_rows[] populated per epic-prep-scenario-contract",
        "widget_ui: scenario_capability_rows.length >= jira_scenario_surfaces.length",
        "each platform_reuse_candidates row has matching scenario_capability_rows platform_invariant entry"
      ],
      "downstream_pointers": ["coverage"]
    },
    "coverage": {
      "contract": "docs/coverage-draft-truth-contract.json",
      "playbook": ".cursor/pipelines/coverage.md",
      "verifier": "python automation/tools/coverage_verify.py --mode draft_truth --ref epics/<KEY>/dependencies/<KEY>-ref.json --coverage epics/<KEY>/dependencies/<KEY>-coverage.json",
      "emit_dod": [
        "coverage_pass 1 or 2; draft_truth_round <= 2",
        "scenario_coverage_map row-complete for primary_candidate and platform_invariant rows",
        "scenario_groups[] when coverage_frozen_at set",
        "smart_checklist_markdown free of internal oracle_rule enum tokens",
        "platform_invariant rows not annex-only"
      ],
      "requires_ref_fields": ["verification_topology.scenario_capability_rows"],
      "downstream_pointers": ["ground"]
    },
    "ground": {
      "contract": "docs/ground-contract.json",
      "playbook": ".cursor/pipelines/ground.md",
      "trigger": "GROUND:",
      "verifier": "python automation/tools/ground_verify.py --mode emit --coverage epics/<KEY>/dependencies/<KEY>-coverage.json --ref epics/<KEY>/dependencies/<KEY>-ref.json",
      "emit_dod": [
        "every console-tagged primary check has runtime_probes or probe_waived with waiver_reason",
        "no temp/ paths in durable JSON",
        "no new checks added; probes and detail_lines only"
      ],
      "downstream_pointers": ["analyse"]
    },
    "analyse": {
      "contract": "docs/analysis-draft-truth-contract.json",
      "playbook": ".cursor/pipelines/analysis.md",
      "verifier": "python automation/tools/analysis_verify.py --mode draft_truth --ref epics/<KEY>/dependencies/<KEY>-ref.json --coverage epics/<KEY>/dependencies/<KEY>-coverage.json --analysis epics/<KEY>/dependencies/<KEY>-analysis.json",
      "emit_dod": [
        "gaps for uncovered scenario rows and failed console probes",
        "draft_truth_recommendation rerun_coverage or human_coverage_review",
        "gaps[] non-empty when scenario_coverage_map has uncovered primaries"
      ],
      "downstream_pointers": ["coverage_review", "discover"]
    },
    "discover": {
      "contract": "docs/discover-linker-contract.json",
      "playbook": ".cursor/pipelines/test-discover.md",
      "verifier": "python automation/tools/discover_verify.py --mode linker --coverage epics/<KEY>/dependencies/<KEY>-coverage.json --discover epics/<KEY>/dependencies/<KEY>-discover.json",
      "emit_dod": [
        "sources.discovery_mode linker_only",
        "obligation_ledger dispositioned; no probe_executed or fe_credentials",
        "coverage.sources.coverage_frozen_at set; no coverage mutation"
      ],
      "downstream_pointers": ["test_prep"]
    },
    "test_prep": {
      "contract": "docs/test-prep-scenario-intent-contract.json",
      "playbook": ".cursor/pipelines/test-prep.md",
      "verifier": "python automation/tools/test_prep_verify.py --mode scenario_intent --ref epics/<KEY>/dependencies/<KEY>-ref.json --coverage epics/<KEY>/dependencies/<KEY>-coverage.json --tests epics/<KEY>/dependencies/<KEY>-tests.json",
      "emit_dod": [
        "sources.draft_profile scenario_intent",
        "one test_bundles[] per scenario_groups[] row",
        "intent actions plain English; deferred checks in excluded_checks_with_reason only",
        "no generation UI exploration"
      ],
      "downstream_pointers": ["close"]
    },
    "close": {
      "contract": "docs/draft-truth-contract.json",
      "playbook": ".cursor/pipelines/close.md",
      "verifier": "python automation/tools/close_verify.py --mode draft_truth --epic-dir epics/<KEY>",
      "emit_dod": [
        "scenario_groups present on frozen coverage",
        "tests scenario_intent shape",
        "draft_truth_round <= max_rounds",
        "no precon required at preflight"
      ]
    }
  },
  "known_limitations": [
    "Machine loop does not reach full gold depth without human coverage review",
    "GROUND requires live CTQA and operator console password",
    "fix_breadth second round capped; remaining gaps go to human gate",
    "Calibrate gold never a generation input",
    "DISCOVER linker does not open browser",
    "TEST-PREP scenario_intent does not emit final CRTQA executable steps — human refinement required",
    "Agent-inferred formulas (4B) may need manual correction"
  ]
}
