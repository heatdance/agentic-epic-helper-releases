{
  "schema_version": 1,
  "description": "Epic pipeline orchestrator: /epic-helper binds one epic per session, one pipeline stage per agent turn, two human gates (draft_truth_v3).",
  "content_policy": "Functional/process only; no secrets in session or scratch files.",
  "epicHelper": {
    "version": 6,
    "command": ".cursor/commands/epic-helper.md",
    "mode": "action_orchestrator",
    "start_phrases": ["/epic-helper"],
    "resume_phrase": "/epic-helper resume",
    "maintainer_golden": "automation/tools/fixtures/operator-assist/epic-helper-golden.json"
  },
  "scratch_paths": {
    "root": "epics/<KEY>/helper/",
    "gitignore_glob": "epics/*/helper/",
    "files": {
      "session": "session.json",
      "operator_feedback": "operator-feedback.md",
      "stage_log": "stage-log.jsonl",
      "affordances_slice": "affordances_slice.json"
    },
    "archive_on_close": {
      "from": "epics/<KEY>/helper/",
      "to": "epics/<KEY>/context/helper/",
      "tool": "automation/tools/close_archive.py"
    }
  },
  "session_schema": {
    "epic_key": "string",
    "active": "boolean",
    "current_stage": "stage id or null when awaiting_gate",
    "next_stage": "stage id after gate cleared",
    "completed_stages": "string[]",
    "awaiting_gate": "env | coverage_review | null",
    "started_at": "ISO-8601",
    "last_resumed_at": "ISO-8601",
    "coverage_md_sha_at_gate": "optional hex for coverage review gate",
    "coverage_frozen_at": "ISO-8601 set when coverage_review gate clears",
    "coverage_json_sha_at_gate": "optional sha256 of -coverage.json at freeze"
  },
  "stages": [
    {
      "id": "env",
      "pipeline_trigger": null,
      "human_gate": true,
      "gate_id": "env",
      "action": "python automation/tools/crtqa_console_probe.py",
      "on_pass_next": "epic_prep"
    },
    {
      "id": "epic_prep",
      "pipeline_trigger": "EPIC-PREP:",
      "human_gate": false,
      "verifier": "python automation/tools/epic_prep_verify.py --mode ref --ref epics/<KEY>/<KEY>-ref.json",
      "on_pass_next": "coverage_v1"
    },
    {
      "id": "coverage_v1",
      "pipeline_trigger": "COVERAGE:",
      "human_gate": false,
      "pre_subagent": "explore dxtrade5-harness + webbroker-harness locations (read-only)",
      "verifier": "python automation/tools/coverage_verify.py --mode draft_truth --ref epics/<KEY>/<KEY>-ref.json --coverage epics/<KEY>/<KEY>-coverage.json",
      "on_pass_next": "ground"
    },
    {
      "id": "ground",
      "pipeline_trigger": "GROUND:",
      "human_gate": false,
      "verifier": "python automation/tools/ground_verify.py --mode emit --coverage epics/<KEY>/<KEY>-coverage.json --ref epics/<KEY>/<KEY>-ref.json",
      "on_pass_next": "analyse"
    },
    {
      "id": "analyse",
      "pipeline_trigger": "ANALYSE:",
      "human_gate": false,
      "default_on": true,
      "verifier": "python automation/tools/analysis_verify.py --mode draft_truth --ref epics/<KEY>/<KEY>-ref.json --coverage epics/<KEY>/<KEY>-coverage.json --analysis epics/<KEY>/<KEY>-analysis.json",
      "on_pass_next": "coverage_fix_breadth_or_review"
    },
    {
      "id": "coverage_fix_breadth",
      "pipeline_trigger": "COVERAGE: fix_breadth=yes",
      "human_gate": false,
      "optional": true,
      "when": "analysis.draft_truth_recommendation == rerun_coverage and draft_truth_round < 2",
      "verifier": "python automation/tools/coverage_verify.py --mode draft_truth --ref epics/<KEY>/<KEY>-ref.json --coverage epics/<KEY>/<KEY>-coverage.json",
      "on_pass_next": "ground"
    },
    {
      "id": "coverage_review_gate",
      "pipeline_trigger": null,
      "human_gate": true,
      "gate_id": "coverage_review",
      "action": "operator merges coverage toward gold; edits scenario_groups[]; sets coverage_frozen_at on resume",
      "on_pass_next": "discover"
    },
    {
      "id": "discover",
      "pipeline_trigger": "TEST-DISCOVER:",
      "human_gate": false,
      "post_action_optional": "python automation/tools/epic_helper_affordances.py when affordances non-empty",
      "verifier": "python automation/tools/discover_verify.py --mode linker --coverage epics/<KEY>/<KEY>-coverage.json --discover epics/<KEY>/<KEY>-discover.json",
      "on_pass_next": "test_prep"
    },
    {
      "id": "test_prep",
      "pipeline_trigger": "TEST-PREP:",
      "human_gate": false,
      "verifier": "python automation/tools/test_prep_verify.py --mode scenario_intent --ref epics/<KEY>/<KEY>-ref.json --coverage epics/<KEY>/<KEY>-coverage.json --tests epics/<KEY>/<KEY>-tests.json",
      "on_pass_next": "close"
    },
    {
      "id": "close",
      "pipeline_trigger": "CLOSE:",
      "human_gate": false,
      "post_action": "archive helper/ → context/helper/",
      "verifier": "python automation/tools/close_verify.py --mode draft_truth --epic-dir epics/<KEY>",
      "on_pass_next": "done"
    }
  ],
  "legacy_stages": [
    {
      "id": "coverage_reinforce",
      "pipeline_trigger": "COVERAGE-REINFORCE:",
      "note": "Opt-in legacy only; conflicts with coverage_immutable after human gate"
    },
    {
      "id": "precon",
      "pipeline_trigger": "TEST-PRECON:",
      "note": "Legacy calibrate/benchmark only; not in draft_truth_v3 production chain"
    }
  ],
  "gates": [
    {
      "id": "env",
      "label": "Console multiplex",
      "recovery": ["/crtqa-console start"],
      "agent_must_not": ["invoke Start-CrtqaConsole from helper", "store passwords"]
    },
    {
      "id": "coverage_review",
      "label": "Coverage draft review",
      "recovery": ["edit epics/<KEY>/<KEY>-coverage.md", "/epic-helper resume with optional comments"]
    }
  ],
  "execution_limits": {
    "one_pipeline_per_agent_turn": true,
    "forbid_playbook_concatenation": true,
    "forbid_summarization_instead_of_artefacts": true,
    "mandatory_jq_before_large_json": true,
    "jq_doc": "automation/docs/jq.md",
    "single_chat_default": true,
    "session_file_is_source_of_truth": true,
    "subagent_explore_before_coverage_stages": ["coverage_v1"],
    "subagent_type": "explore",
    "max_parallel_subagents": 2
  },
  "pipeline_chain_default": [
    "EPIC-PREP",
    "COVERAGE",
    "GROUND",
    "ANALYSE",
    "TEST-DISCOVER",
    "TEST-PREP",
    "CLOSE"
  ],
  "draft_truth_contract": "docs/draft-truth-contract.json",
  "cold_reads": [
    "docs/epic-helper-contract.json",
    ".cursor/commands/epic-helper.md",
    "docs/harness-principles.md",
    "HOW-TO.md"
  ]
}
