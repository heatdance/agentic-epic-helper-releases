with draft_h = customfield_11250 :

with has_draft =
  DEFINED(draft_h)
  AND draft_h > 0 :

with has_rem =
  DEFINED(remainingEstimate)
  AND remainingEstimate > 0 :

with has_some_est =
  has_draft
  OR has_rem :

with has_logged =
  DEFINED(timespent)
  AND timespent > 0 :

with ticket_est =
  IF (
    has_logged;
    remainingEstimate;
    IF (
      has_draft;
      DURATION(CONCAT(TEXT(draft_h); "h"));
      originalEstimate
    )
  ) :

with is_ra =
  MATCH(issuetype, "QA Task")
  AND MATCH(customfield_20572, "Requirements analysis") :

with is_cr =
  MATCH(issuetype, "QA Task")
  AND MATCH(customfield_20572, "Test cases review") :

with is_tc =
  (
    MATCH(issuetype, "QA Task")
    AND MATCH(customfield_20572, "Test cases development")
  )
  OR (
    MATCH(issuetype, "Test Execution")
    AND MATCH(summary, "*Test Case Development*")
  ) :

with is_val =
  MATCH(issuetype, "Test Execution")
  AND (
    MATCH(summary, "*Epic Validation*")
    OR MATCH(summary, "*Epic Testing*")
  ) :

with in_qa_lane =
  is_ra
  OR is_cr
  OR is_tc
  OR is_val :

with in_qa_lane_agg =
  is_ra
  OR is_tc
  OR is_val :

with epic_in_scope =
  MATCH(issuetype, "Epic")
  AND (
    MATCH(status, "Validation")
    OR MATCH(status, "Pending Fix")
    OR MATCH(status, "Under Implementation")
  ) :

with under_scope_epic =
  PARENT {
    with p_slot_ra =
      COUNT#children#truthy {
        MATCH(issuetype, "QA Task")
        AND MATCH(customfield_20572, "Requirements analysis")
      } > 0 :
    with p_slot_cr =
      COUNT#children#truthy {
        MATCH(issuetype, "QA Task")
        AND MATCH(customfield_20572, "Test cases review")
      } > 0 :
    with p_slot_tc =
      COUNT#children#truthy {
        (
          MATCH(issuetype, "QA Task")
          AND MATCH(customfield_20572, "Test cases development")
        )
        OR (
          MATCH(issuetype, "Test Execution")
          AND MATCH(summary, "*Test Case Development*")
        )
      } > 0 :
    with p_slot_val =
      COUNT#children#truthy {
        MATCH(issuetype, "Test Execution")
        AND (
          MATCH(summary, "*Epic Validation*")
          OR MATCH(summary, "*Epic Testing*")
        )
      } > 0 :
    with p_any_slot =
      p_slot_ra
      OR p_slot_cr
      OR p_slot_tc
      OR p_slot_val :
    with p_full_range =
      p_slot_ra
      AND p_slot_cr
      AND p_slot_tc
      AND p_slot_val :
    with p_duplicate_tc =
      COUNT#children#truthy {
        (
          MATCH(issuetype, "QA Task")
          AND MATCH(customfield_20572, "Test cases development")
        )
        OR (
          MATCH(issuetype, "Test Execution")
          AND MATCH(summary, "*Test Case Development*")
        )
      } > 1 :
    with p_missing_est =
      COUNT#children#truthy {
        with draft_h = customfield_11250 :
        with has_draft =
          DEFINED(draft_h)
          AND draft_h > 0 :
        with has_rem =
          DEFINED(remainingEstimate)
          AND remainingEstimate > 0 :
        (
          (
            MATCH(issuetype, "QA Task")
            AND MATCH(customfield_20572, "Requirements analysis")
          )
          OR (
            MATCH(issuetype, "QA Task")
            AND MATCH(customfield_20572, "Test cases review")
          )
          OR (
            (
              MATCH(issuetype, "QA Task")
              AND MATCH(customfield_20572, "Test cases development")
            )
            OR (
              MATCH(issuetype, "Test Execution")
              AND MATCH(summary, "*Test Case Development*")
            )
          )
          OR (
            MATCH(issuetype, "Test Execution")
            AND (
              MATCH(summary, "*Epic Validation*")
              OR MATCH(summary, "*Epic Testing*")
            )
          )
        )
        AND status != "Closed"
        AND status != "Aborted"
        AND NOT (
          has_draft
          OR has_rem
        )
      } > 0 :
    with p_incomplete =
      NOT p_full_range
      OR p_duplicate_tc
      OR p_missing_est :
    IF (
      MATCH(issuetype, "Epic")
      AND (
        MATCH(status, "Validation")
        OR MATCH(status, "Pending Fix")
        OR MATCH(status, "Under Implementation")
      )
      AND NOT labels.CONTAINS("qa-no-task")
      AND p_any_slot
      AND NOT p_incomplete;
      1
    )
  } :

with excluded_leaf =
  labels.CONTAINS("qa-no-task")
  OR SJQL { descendant of folder("Archive") }
  OR JQL { project = PMOPROC AND summary ~ "Fixed Cost Corner Trader M&S" }
  OR SJQL { descendant of [project = PMOPROC AND summary ~ "Fixed Cost Corner Trader M&S"] } :

with counts_in_sum =
  in_qa_lane_agg
  AND status != "Closed"
  AND status != "Aborted"
  AND NOT excluded_leaf
  AND (
    DEFINED(under_scope_epic)
    AND under_scope_epic > 0
  ) :

with display_est =
  IF (
    status = "Closed";
    "done";
    IF (
      status = "Aborted";
      "none";
      IF (
        NOT has_some_est;
        "(?)";
        ticket_est
      )
    )
  ) :

with leaf_hours =
  SUM#leaves#strict {
    with draft_h = customfield_11250 :
    with has_draft =
      DEFINED(draft_h)
      AND draft_h > 0 :
    with has_rem =
      DEFINED(remainingEstimate)
      AND remainingEstimate > 0 :
    with has_logged =
      DEFINED(timespent)
      AND timespent > 0 :
    with ticket_est =
      IF (
        has_logged;
        remainingEstimate;
        IF (
          has_draft;
          DURATION(CONCAT(TEXT(draft_h); "h"));
          originalEstimate
        )
      ) :
    with is_ra =
      MATCH(issuetype, "QA Task")
      AND MATCH(customfield_20572, "Requirements analysis") :
    with is_cr =
      MATCH(issuetype, "QA Task")
      AND MATCH(customfield_20572, "Test cases review") :
    with is_tc =
      (
        MATCH(issuetype, "QA Task")
        AND MATCH(customfield_20572, "Test cases development")
      )
      OR (
        MATCH(issuetype, "Test Execution")
        AND MATCH(summary, "*Test Case Development*")
      ) :
    with is_val =
      MATCH(issuetype, "Test Execution")
      AND (
        MATCH(summary, "*Epic Validation*")
        OR MATCH(summary, "*Epic Testing*")
      ) :
    with in_qa_lane_agg =
      is_ra
      OR is_tc
      OR is_val :
    with under_scope_epic =
      PARENT {
        with p_slot_ra =
          COUNT#children#truthy {
            MATCH(issuetype, "QA Task")
            AND MATCH(customfield_20572, "Requirements analysis")
          } > 0 :
        with p_slot_cr =
          COUNT#children#truthy {
            MATCH(issuetype, "QA Task")
            AND MATCH(customfield_20572, "Test cases review")
          } > 0 :
        with p_slot_tc =
          COUNT#children#truthy {
            (
              MATCH(issuetype, "QA Task")
              AND MATCH(customfield_20572, "Test cases development")
            )
            OR (
              MATCH(issuetype, "Test Execution")
              AND MATCH(summary, "*Test Case Development*")
            )
          } > 0 :
        with p_slot_val =
          COUNT#children#truthy {
            MATCH(issuetype, "Test Execution")
            AND (
              MATCH(summary, "*Epic Validation*")
              OR MATCH(summary, "*Epic Testing*")
            )
          } > 0 :
        with p_any_slot =
          p_slot_ra
          OR p_slot_cr
          OR p_slot_tc
          OR p_slot_val :
        with p_full_range =
          p_slot_ra
          AND p_slot_cr
          AND p_slot_tc
          AND p_slot_val :
        with p_duplicate_tc =
          COUNT#children#truthy {
            (
              MATCH(issuetype, "QA Task")
              AND MATCH(customfield_20572, "Test cases development")
            )
            OR (
              MATCH(issuetype, "Test Execution")
              AND MATCH(summary, "*Test Case Development*")
            )
          } > 1 :
        with p_missing_est =
          COUNT#children#truthy {
            with draft_h = customfield_11250 :
            with has_draft =
              DEFINED(draft_h)
              AND draft_h > 0 :
            with has_rem =
              DEFINED(remainingEstimate)
              AND remainingEstimate > 0 :
            (
              (
                MATCH(issuetype, "QA Task")
                AND MATCH(customfield_20572, "Requirements analysis")
              )
              OR (
                MATCH(issuetype, "QA Task")
                AND MATCH(customfield_20572, "Test cases review")
              )
              OR (
                (
                  MATCH(issuetype, "QA Task")
                  AND MATCH(customfield_20572, "Test cases development")
                )
                OR (
                  MATCH(issuetype, "Test Execution")
                  AND MATCH(summary, "*Test Case Development*")
                )
              )
              OR (
                MATCH(issuetype, "Test Execution")
                AND (
                  MATCH(summary, "*Epic Validation*")
                  OR MATCH(summary, "*Epic Testing*")
                )
              )
            )
            AND status != "Closed"
            AND status != "Aborted"
            AND NOT (
              has_draft
              OR has_rem
            )
          } > 0 :
        with p_incomplete =
          NOT p_full_range
          OR p_duplicate_tc
          OR p_missing_est :
        IF (
          MATCH(issuetype, "Epic")
          AND (
            MATCH(status, "Validation")
            OR MATCH(status, "Pending Fix")
            OR MATCH(status, "Under Implementation")
          )
          AND NOT labels.CONTAINS("qa-no-task")
          AND p_any_slot
          AND NOT p_incomplete;
          1
        )
      } :
    with excluded_leaf =
      labels.CONTAINS("qa-no-task")
      OR SJQL { descendant of folder("Archive") }
      OR JQL { project = PMOPROC AND summary ~ "Fixed Cost Corner Trader M&S" }
      OR SJQL { descendant of [project = PMOPROC AND summary ~ "Fixed Cost Corner Trader M&S"] } :
    with counts_in_sum =
      in_qa_lane_agg
      AND status != "Closed"
      AND status != "Aborted"
      AND NOT excluded_leaf
      AND (
        DEFINED(under_scope_epic)
        AND under_scope_epic > 0
      ) :
    IF (counts_in_sum; ticket_est)
  } :

with scope_epics_in_subtree =
  COUNT#subtree#truthy {
    with p_slot_ra =
      COUNT#children#truthy {
        MATCH(issuetype, "QA Task")
        AND MATCH(customfield_20572, "Requirements analysis")
      } > 0 :
    with p_slot_cr =
      COUNT#children#truthy {
        MATCH(issuetype, "QA Task")
        AND MATCH(customfield_20572, "Test cases review")
      } > 0 :
    with p_slot_tc =
      COUNT#children#truthy {
        (
          MATCH(issuetype, "QA Task")
          AND MATCH(customfield_20572, "Test cases development")
        )
        OR (
          MATCH(issuetype, "Test Execution")
          AND MATCH(summary, "*Test Case Development*")
        )
      } > 0 :
    with p_slot_val =
      COUNT#children#truthy {
        MATCH(issuetype, "Test Execution")
        AND (
          MATCH(summary, "*Epic Validation*")
          OR MATCH(summary, "*Epic Testing*")
        )
      } > 0 :
    with p_any_slot =
      p_slot_ra
      OR p_slot_cr
      OR p_slot_tc
      OR p_slot_val :
    with p_full_range =
      p_slot_ra
      AND p_slot_cr
      AND p_slot_tc
      AND p_slot_val :
    with p_duplicate_tc =
      COUNT#children#truthy {
        (
          MATCH(issuetype, "QA Task")
          AND MATCH(customfield_20572, "Test cases development")
        )
        OR (
          MATCH(issuetype, "Test Execution")
          AND MATCH(summary, "*Test Case Development*")
        )
      } > 1 :
    with p_missing_est =
      COUNT#children#truthy {
        with draft_h = customfield_11250 :
        with has_draft =
          DEFINED(draft_h)
          AND draft_h > 0 :
        with has_rem =
          DEFINED(remainingEstimate)
          AND remainingEstimate > 0 :
        (
          (
            MATCH(issuetype, "QA Task")
            AND MATCH(customfield_20572, "Requirements analysis")
          )
          OR (
            MATCH(issuetype, "QA Task")
            AND MATCH(customfield_20572, "Test cases review")
          )
          OR (
            (
              MATCH(issuetype, "QA Task")
              AND MATCH(customfield_20572, "Test cases development")
            )
            OR (
              MATCH(issuetype, "Test Execution")
              AND MATCH(summary, "*Test Case Development*")
            )
          )
          OR (
            MATCH(issuetype, "Test Execution")
            AND (
              MATCH(summary, "*Epic Validation*")
              OR MATCH(summary, "*Epic Testing*")
            )
          )
        )
        AND status != "Closed"
        AND status != "Aborted"
        AND NOT (
          has_draft
          OR has_rem
        )
      } > 0 :
    with p_incomplete =
      NOT p_full_range
      OR p_duplicate_tc
      OR p_missing_est :
    MATCH(issuetype, "Epic")
    AND (
      MATCH(status, "Validation")
      OR MATCH(status, "Pending Fix")
      OR MATCH(status, "Under Implementation")
    )
    AND NOT labels.CONTAINS("qa-no-task")
    AND p_any_slot
    AND NOT p_incomplete
  } :

with slot_ra =
  COUNT#subtree#truthy {
    MATCH(issuetype, "QA Task")
    AND MATCH(customfield_20572, "Requirements analysis")
  } > 0 :

with slot_cr =
  COUNT#subtree#truthy {
    MATCH(issuetype, "QA Task")
    AND MATCH(customfield_20572, "Test cases review")
  } > 0 :

with slot_tc =
  COUNT#subtree#truthy {
    (
      MATCH(issuetype, "QA Task")
      AND MATCH(customfield_20572, "Test cases development")
    )
    OR (
      MATCH(issuetype, "Test Execution")
      AND MATCH(summary, "*Test Case Development*")
    )
  } > 0 :

with slot_val =
  COUNT#subtree#truthy {
    MATCH(issuetype, "Test Execution")
    AND (
      MATCH(summary, "*Epic Validation*")
      OR MATCH(summary, "*Epic Testing*")
    )
  } > 0 :

with any_slot =
  slot_ra
  OR slot_cr
  OR slot_tc
  OR slot_val :

with full_range =
  slot_ra
  AND slot_cr
  AND slot_tc
  AND slot_val :

with duplicate_tc =
  COUNT#subtree#truthy {
    (
      MATCH(issuetype, "QA Task")
      AND MATCH(customfield_20572, "Test cases development")
    )
    OR (
      MATCH(issuetype, "Test Execution")
      AND MATCH(summary, "*Test Case Development*")
    )
  } > 1 :

with missing_est =
  COUNT#subtree#truthy {
    with draft_h = customfield_11250 :
    with has_draft =
      DEFINED(draft_h)
      AND draft_h > 0 :
    with has_rem =
      DEFINED(remainingEstimate)
      AND remainingEstimate > 0 :
    (
      (
        MATCH(issuetype, "QA Task")
        AND MATCH(customfield_20572, "Requirements analysis")
      )
      OR (
        MATCH(issuetype, "QA Task")
        AND MATCH(customfield_20572, "Test cases review")
      )
      OR (
        (
          MATCH(issuetype, "QA Task")
          AND MATCH(customfield_20572, "Test cases development")
        )
        OR (
          MATCH(issuetype, "Test Execution")
          AND MATCH(summary, "*Test Case Development*")
        )
      )
      OR (
        MATCH(issuetype, "Test Execution")
        AND (
          MATCH(summary, "*Epic Validation*")
          OR MATCH(summary, "*Epic Testing*")
        )
      )
    )
    AND status != "Closed"
    AND status != "Aborted"
    AND NOT (
      has_draft
      OR has_rem
    )
  } > 0 :

with epic_incomplete =
  NOT full_range
  OR duplicate_tc
  OR missing_est :

with show_not_defined = "(?) not defined" :

with show_incomplete = "(!) incomplete" :

with show_blank =
  SJQL { descendant of folder("Archive") }
  OR MATCH(summary, "Archive")
  OR MATCH(summary, "Active Epics (ph4/ph5)")
  OR MATCH(summary, "Active Epics (Other)")
  OR MATCH(summary, "*Fixed Cost*Corner Trader*M&S*")
  OR JQL { project = PMOPROC AND summary ~ "Fixed Cost Corner Trader M&S" }
  OR SJQL { descendant of [project = PMOPROC AND summary ~ "Fixed Cost Corner Trader M&S"] } :

IF (
  show_blank;
  "";
  IF (
    in_qa_lane;
    IF (
      DEFINED(under_scope_epic)
      AND under_scope_epic > 0;
      display_est;
      ""
    );
    IF (
      epic_in_scope;
      IF (
        labels.CONTAINS("qa-no-task");
        "";
        IF (
          NOT any_slot;
          show_not_defined;
          IF (
            epic_incomplete;
            show_incomplete;
            leaf_hours
          )
        )
      );
      IF (
        scope_epics_in_subtree > 0;
        leaf_hours;
        ""
      )
    )
  )
)
