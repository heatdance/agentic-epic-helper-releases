IF this.issuetype != "Epic" : "" ELSE:

IF this.labels.CONTAINS("qa-no-task") OR stories.FILTER(MATCH($.issuetype, "Test Execution") AND $.status = "Closed" AND (MATCH($.summary, "*Epic Validation*") OR MATCH($.summary, "*Epic Testing*"))).SIZE() > 0: "Skipped" ELSE:

with tctasks = stories
               .FILTER(MATCH($.issuetype, "QA Task"))
               .FILTER(MATCH($.customfield_20572, "Test cases review"))
               .FILTER($.status != "Aborted"):

IF tctasks.SIZE() > 1: 
  CONCAT("(!) ",tctasks.SIZE())

ELSE: IF tctasks.SIZE() = 1:
  with tctask = tctasks.MAP($.key):
  CONCAT("[", tctasks.status, "|", tctask, "]")

ELSE: 
  with icon = 
    IF (this.status = "NEW" or this.status = "REQUIREMENTS REVIEW" ): "" ELSE:
    IF (DEFINED(this.customfield_61071)): this.customfield_61071 ELSE:
    IF (this.status = "Validation" or this.status = "Closed" or this.status = "Pending Resolution"): "(flag)"
    ELSE "(flagoff)":

  with safe_summary = REPLACE(REPLACE(URL_DECODE(this.summary), "[", "\["), "]", "\]"):
  with description = CONCAT("Review+test+coverage+created+under+", this.key, "."):

  with static_args = "pid=31060&issuetype=11000&customfield_20572=31582&assignee=ct-qa&priority=4&timetracking=4h":
  with epic_args = CONCAT(
    "&summary=", "<PROJECT>[Test+Coverage+Review]+", this.key, ":+", safe_summary,
    "&customfield_15471=", this.key,
    "&description=", description
  ):
  CONCAT(icon, "[+", "|", "https://jira.in.devexperts.com/secure/CreateIssueDetails!init.jspa?", static_args, epic_args, "]")