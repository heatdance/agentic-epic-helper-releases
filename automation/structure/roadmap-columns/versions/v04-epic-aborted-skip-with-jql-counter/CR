               .FILTER(MATCH($.customfield_20572, "Test cases review")):

IF this.status = "Aborted" AND abortMatches.SIZE() = 0 : "Skipped"
ELSE: IF this.status = "Aborted": CONCAT("Skipped (", "[", abortMatches.SIZE(), "|", CONCAT("https://jira.in.devexperts.com/issues/?jql=cf%5B15471%5D%20%3D%20", this.key, "%20AND%20issuetype%20%3D%20%22QA%20Task%22%20AND%20cf%5B20572%5D%20%3D%20%22Test%20cases%20review%22"), "])")
ELSE:

IF this.labels.CONTAINS("qa-no-task"): "Skipped" ELSE:

with tctasks = stories
               .FILTER(MATCH($.issuetype, "QA Task"))
               .FILTER(MATCH($.customfield_20572, "Test cases review"))
               .FILTER($.status != "Aborted"):

IF tctasks.SIZE() > 1:
  CONCAT("(!) ",tctasks.SIZE())

ELSE: IF tctasks.SIZE() = 1:
  with tctask = tctasks.MAP($.key):
