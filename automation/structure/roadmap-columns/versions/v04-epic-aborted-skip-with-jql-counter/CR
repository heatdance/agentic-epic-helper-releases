  with safe_summary = REPLACE(REPLACE(URL_DECODE(this.summary), "[", "\["), "]", "\]"):
  with description = CONCAT("Review+test+coverage+created+under+", this.key, "."):

  with static_args = "pid=31060&issuetype=11000&customfield_20572=31582&assignee=ct-qa&priority=4&timetracking=4h":
  with epic_args = CONCAT(
