{
  "_comment": "Personal tree: postgres-ctqa + chrome-devtools (project and/or global mcp.json). Atlassian/Figma: global ~/.cursor/mcp.json — see .cursor/mcp.json.team.example for full scrubbed team template. CLEAN public phase must not delete gitignored .cursor/mcp.json.",
  "mcpServers": {
    "postgres-ctqa": {
      "command": "npx",
      "args": [
        "-y",
        "@sarmadparvez/postgresql-mcp",
        "postgresql://USER:PASSWORD@127.0.0.1:15432/ctqa?mode=readonly&sslmode=disable"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    }
  }
}
